---
import '../styles/global.css';
import '../styles/refinements.css';
import '../styles/release.css';
import '../styles/motion.css';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
}

const {
  title = site.title,
  description = site.description,
  canonical = Astro.url.pathname,
  image = '/assets/og-default.png'
} = Astro.props;

const canonicalUrl = new URL(canonical, site.url).toString();
const imageUrl = new URL(image, site.url).toString();
const imageType = imageUrl.endsWith('.png') ? 'image/png' : imageUrl.endsWith('.svg') ? 'image/svg+xml' : imageUrl.endsWith('.webp') ? 'image/webp' : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.professionalName,
  url: site.url,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  sameAs: [
    site.social.linkedin,
    site.social.github,
    site.social.freelancer,
    site.social.facebook
  ]
};
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1118" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    {imageType && <meta property="og:image:type" content={imageType} />}
    <meta property="og:site_name" content="JC Pelotea Professional Portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('jc-theme');
        const preferred = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = saved || preferred;
      })();
    </script>
    <script is:inline>
      (() => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const root = document.documentElement;
        root.classList.add('motion-enabled');
        window.__jcMotionFallback = window.setTimeout(() => {
          if (!root.classList.contains('motion-ready')) root.classList.remove('motion-enabled');
        }, 2500);
      })();
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <div class="mobile-action-bar glass-panel" data-mobile-action-bar aria-label="Quick contact actions">
      <a class="button" href={site.booking} target="_blank" rel="noopener">Book a call ↗</a>
      <a class="button button--ghost" href={`mailto:${site.email}`}>Email JC</a>
    </div>

    <a class="back-to-top glass-panel" href="#top" data-back-to-top aria-label="Back to top" title="Back to top">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6.5 10 5.5-5.5 5.5 5.5M12 5v14.5" />
      </svg>
    </a>

    <dialog class="lightbox-dialog" data-lightbox-dialog aria-label="Expanded portfolio image">
      <button class="lightbox-close" type="button" data-lightbox-close aria-label="Close image preview">×</button>
      <figure>
        <img data-lightbox-image src="" alt="" />
        <figcaption data-lightbox-caption></figcaption>
      </figure>
    </dialog>

    <script is:inline>
      const reducedMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
      const afterPaint = (callback) => {
        let completed = false;
        const run = () => {
          if (completed) return;
          completed = true;
          callback();
        };
        requestAnimationFrame(run);
        window.setTimeout(run, 64);
      };
      let mobileMenuTimer;
      let lightboxTimer;
      let backToTopFrame;

      const setMobileMenu = (open, restoreFocus = false) => {
        const menu = document.querySelector('[data-mobile-menu]');
        const toggle = document.querySelector('[data-mobile-menu-toggle]');
        if (!(menu instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;
        window.clearTimeout(mobileMenuTimer);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');

        if (open) {
          menu.hidden = false;
          menu.removeAttribute('inert');
          menu.dataset.state = reducedMotion() ? 'open' : 'opening';
          afterPaint(() => {
            menu.dataset.state = 'open';
            const firstLink = menu.querySelector('a');
            if (firstLink instanceof HTMLElement) firstLink.focus();
          });
          return;
        }

        if (menu.hidden) {
          if (restoreFocus) toggle.focus();
          return;
        }

        menu.dataset.state = 'closing';
        if (menu.contains(document.activeElement)) toggle.focus({ preventScroll: true });
        menu.setAttribute('inert', '');
        const finishClose = () => {
          menu.hidden = true;
          menu.removeAttribute('data-state');
          menu.removeAttribute('inert');
          if (restoreFocus) toggle.focus();
        };

        if (reducedMotion()) finishClose();
        else mobileMenuTimer = window.setTimeout(finishClose, 150);
      };

      const closeLightbox = () => {
        const dialog = document.querySelector('[data-lightbox-dialog]');
        if (!(dialog instanceof HTMLDialogElement) || !dialog.open || dialog.dataset.state === 'closing') return;
        window.clearTimeout(lightboxTimer);
        dialog.dataset.state = 'closing';
        const finishClose = () => {
          dialog.close();
          dialog.removeAttribute('data-state');
        };
        if (reducedMotion()) finishClose();
        else lightboxTimer = window.setTimeout(finishClose, 180);
      };

      const initMotion = () => {
        const root = document.documentElement;
        if (!root.classList.contains('motion-enabled')) return;

        try {
          const reveal = (element) => element.classList.add('is-visible');
          const scrollItems = [...document.querySelectorAll('[data-motion]:not([data-motion="hero"]):not([data-motion="hero-card"])')];
          const timeline = document.querySelector('[data-motion-timeline]');

          if (!('IntersectionObserver' in window)) {
            scrollItems.forEach(reveal);
            if (timeline) timeline.classList.add('is-visible');
          } else {
            const observer = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                reveal(entry.target);
                observer.unobserve(entry.target);
              });
            }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

            scrollItems.forEach((item) => observer.observe(item));
            if (timeline) observer.observe(timeline);
          }

          root.classList.add('motion-ready');
          window.clearTimeout(window.__jcMotionFallback);
          afterPaint(() => {
            document.querySelectorAll('[data-motion="hero"], [data-motion="hero-card"]').forEach(reveal);
            window.setTimeout(() => document.querySelector('[data-mobile-action-bar]')?.classList.add('is-visible'), 280);
          });
        } catch (error) {
          root.classList.remove('motion-enabled', 'motion-ready');
        }
      };

      initMotion();

      const updateBackToTop = () => {
        backToTopFrame = undefined;
        const control = document.querySelector('[data-back-to-top]');
        if (!(control instanceof HTMLElement)) return;
        const threshold = Math.max(560, window.innerHeight * .75);
        control.classList.toggle('is-visible', window.scrollY > threshold);
      };

      updateBackToTop();
      window.addEventListener('scroll', () => {
        if (backToTopFrame) return;
        backToTopFrame = requestAnimationFrame(updateBackToTop);
      }, { passive: true });

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;

        const backToTop = event.target.closest('[data-back-to-top]');
        if (backToTop instanceof HTMLAnchorElement) {
          event.preventDefault();
          window.scrollTo({ top: 0, behavior: reducedMotion() ? 'auto' : 'smooth' });
          return;
        }

        const menuToggle = event.target.closest('[data-mobile-menu-toggle]');
        if (menuToggle instanceof HTMLButtonElement) {
          const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
          setMobileMenu(!isOpen);
          return;
        }

        const mobileMenu = document.querySelector('[data-mobile-menu]');
        if (mobileMenu instanceof HTMLElement && !mobileMenu.hidden) {
          if (event.target.closest('[data-mobile-menu] a')) {
            setMobileMenu(false);
          } else if (!event.target.closest('[data-mobile-menu]')) {
            setMobileMenu(false);
          }
        }

        const themeButton = event.target.closest('[data-theme-toggle]');
        if (themeButton) {
          const root = document.documentElement;
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          localStorage.setItem('jc-theme', next);
          themeButton.setAttribute('aria-label', `Switch to ${next === 'dark' ? 'light' : 'dark'} theme`);
          return;
        }

        const trigger = event.target.closest('[data-lightbox-src]');
        if (trigger instanceof HTMLElement) {
          event.preventDefault();
          const dialog = document.querySelector('[data-lightbox-dialog]');
          const image = dialog?.querySelector('[data-lightbox-image]');
          const caption = dialog?.querySelector('[data-lightbox-caption]');
          if (dialog instanceof HTMLDialogElement && image instanceof HTMLImageElement && caption instanceof HTMLElement) {
            window.clearTimeout(lightboxTimer);
            image.src = trigger.dataset.lightboxSrc || '';
            image.alt = trigger.dataset.lightboxAlt || '';
            caption.textContent = trigger.dataset.lightboxCaption || trigger.dataset.lightboxAlt || '';
            dialog.showModal();
            dialog.dataset.state = reducedMotion() ? 'open' : 'opening';
            afterPaint(() => { dialog.dataset.state = 'open'; });
          }
          return;
        }

        const close = event.target.closest('[data-lightbox-close]');
        if (close) {
          closeLightbox();
          return;
        }

        if (event.target instanceof HTMLDialogElement && event.target.matches('[data-lightbox-dialog]')) {
          closeLightbox();
        }
      });

      document.querySelector('[data-lightbox-dialog]')?.addEventListener('cancel', (event) => {
        event.preventDefault();
        closeLightbox();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          const dialog = document.querySelector('[data-lightbox-dialog]');
          if (dialog instanceof HTMLDialogElement && dialog.open) {
            event.preventDefault();
            closeLightbox();
            return;
          }
          const menu = document.querySelector('[data-mobile-menu]');
          if (menu instanceof HTMLElement && !menu.hidden) setMobileMenu(false, true);
        }
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth > 980) setMobileMenu(false);
      });

      matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (event) => {
        if (!event.matches) return;
        document.documentElement.classList.remove('motion-enabled', 'motion-ready');
        document.querySelectorAll('[data-motion], [data-motion-timeline], [data-mobile-action-bar]').forEach((element) => element.classList.add('is-visible'));
      });
    </script>
  </body>
</html>
