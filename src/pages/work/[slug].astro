---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects';
import type { Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const title = `${project.title} | Joshua Carl Pelotea (JC)`;
const description = `${project.title} case study by Joshua Carl Pelotea (JC): ${project.summary}`;
---
<BaseLayout title={title} description={description} canonical={`/work/${project.slug}/`} image={project.socialImage || project.image || '/assets/og-default.png'}>
  <Header />
  <main id="main">
    <section class="page-hero">
      <div class="container case-hero">
        <div class="case-copy">
          <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/work/">Work</a><span>/</span><span>{project.title}</span></div>
          <p class="eyebrow">Case Study · {project.category}</p>
          <h1 class="case-title">{project.title}</h1>
          <p class="lede">{project.summary}</p>
          {(project.live || project.github) && (
            <div class="hero-actions case-actions">
              {project.live && <a class="button" href={project.live} target="_blank" rel="noopener">{project.liveLabel || 'Open live project ↗'}</a>}
              {project.github && <a class="button button--ghost" href={project.github} target="_blank" rel="noopener">GitHub ↗</a>}
            </div>
          )}
          {project.liveNote && <p class="case-link-note">{project.liveNote}</p>}
        </div>
        {project.image ? (
          <button
            class="case-visual case-visual--button"
            type="button"
            data-lightbox-src={project.image}
            data-lightbox-alt={project.imageAlt || ''}
            data-lightbox-caption={project.imageAlt || `${project.title} — project preview`}
            aria-label={`View larger ${project.title} preview`}
          >
            <img
              src={project.image}
              alt={project.imageAlt || ''}
              width={project.imageWidth}
              height={project.imageHeight}
            />
            <span class="zoom-badge" aria-hidden="true">View larger ⤢</span>
          </button>
        ) : (
          <div class="case-visual"><div class="project-visual project-visual--abstract" style="height:100%"></div></div>
        )}
      </div>
    </section>

    <section class="section--compact">
      <div class="container">
        <article class="case-section">
          <aside>01 · Context</aside>
          <div class="content"><h2>The challenge</h2><p>{project.challenge}</p></div>
        </article>
        <article class="case-section">
          <aside>02 · Approach</aside>
          <div class="content"><h2>The approach</h2><p>{project.approach}</p></div>
        </article>
        <article class="case-section">
          <aside>03 · Contribution</aside>
          <div class="content"><h2>What I contributed</h2><ul class="clean-list">{project.contributions.map((item) => <li>{item}</li>)}</ul></div>
        </article>
        <article class="case-section">
          <aside>04 · Evidence</aside>
          <div class="content"><h2>Key deliverables</h2><ul class="clean-list">{project.deliverables.map((item) => <li>{item}</li>)}</ul><p>{project.evidenceNote || 'Public evidence focuses on publishable artifacts and selected deliverables while confidential business information and applicant-level personal data remain private.'}</p></div>
        </article>
        <article class="case-section">
          <aside>05 · Outcome</aside>
          <div class="content"><h2>The result</h2><p>{project.outcome}</p></div>
        </article>
        <article class="case-section">
          <aside>06 · Environment</aside>
          <div class="content"><h2>Tools used</h2><ul class="pill-list">{project.tools.map((tool) => <li>{tool}</li>)}</ul></div>
        </article>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
