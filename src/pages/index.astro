---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';
import { site } from '../site.config';

const capabilities = [
  ['01 · Core', 'Business Operations', 'Administrative coordination, operational support, reporting, task management, workflow organization, and day-to-day execution.'],
  ['02', 'Executive Support', 'Calendar management, appointment coordination, executive communication, documentation, and leadership support.'],
  ['03', 'Workflow Automation', 'Google Sheets, Apps Script, automated dashboards, trackers, and practical process optimization.'],
  ['04', 'Business Documentation', 'SOPs, policies, proposals, service agreements, process documentation, and internal knowledge systems.'],
  ['05', 'Digital Operations', 'Website management, content updates, QA, GitHub workflows, deployments, and digital systems support.'],
  ['06', 'Marketing Support', 'Content planning, social media coordination, campaign support, graphic design, and marketing operations.']
];

const experience = [
  ['2026 — Present', 'Avodah Wealth Advisory', 'Administrative Assistant / General Admin Support', 'Business operations, executive coordination, recruitment, CRM/client workflows, dashboards, documentation, website operations, and digital marketing support.'],
  ['2025', 'KRISS.AI', 'Outreach Specialist & Co-Team Leader · Part-time', 'Outreach coordination, prospect communication, lead follow-up, and AI-solution positioning for healthcare organizations.'],
  ['2023', 'Teleperformance', 'Customer Service Representative', 'High-volume customer support, CRM records, follow-ups, issue resolution, and service-quality execution.'],
  ['2022', 'Concentrix', 'Customer Service Representative', 'Outbound customer communication, renewals, account updates, objection handling, and internal coordination.'],
  ['2022', 'Philippine Army Reserve Command', 'Documentation & Communication Officer', 'Official documentation, reports, records, scheduling, and structured internal communication.'],
  ['2018 — 2021', 'Barangay Tagabaca', 'Sangguniang Kabataan Chairman', 'Leadership, community-project coordination, budgeting, documentation, events, and stakeholder communication.']
];
---
<BaseLayout>
  <Header />
  <main id="main">
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <p class="eyebrow">Joshua Carl Pelotea · Known professionally as JC</p>
          <h1>Bringing structure to <span class="soft">people, processes,</span> and daily execution.</h1>
          <p class="lede">I help executives, entrepreneurs, and growing businesses stay organized, efficient, and focused on growth through reliable administrative, operational, and digital support.</p>
          <div class="hero-actions">
            <a class="button" href="/work/">View selected work <span aria-hidden="true">→</span></a>
            <a class="button button--ghost" href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          </div>
          <div class="hero-meta" aria-label="Core disciplines">
            <span class="tag">Business Operations</span>
            <span class="tag">Executive Support</span>
            <span class="tag">Workflow Automation</span>
            <span class="tag">Digital Operations</span>
          </div>
        </div>
        <aside class="identity-card glass-panel">
          <small>The operations mindset</small>
          <blockquote>Support both people and processes.</blockquote>
          <p>Clear priorities. Practical systems. Proactive communication. Reliable follow-through.</p>
          <ol class="identity-list">
            <li>Organize the work</li>
            <li>Coordinate the moving parts</li>
            <li>Improve the system</li>
            <li>Follow through consistently</li>
          </ol>
        </aside>
      </div>
    </section>

    <section class="section" id="capabilities">
      <div class="container">
        <div class="section-heading">
          <div><p class="eyebrow">Capabilities</p><h2>Operations-led support with a practical digital layer.</h2></div>
          <p>Business Operations is the anchor. The supporting capabilities extend the same focus on clarity, visibility, accountability, and consistent execution.</p>
        </div>
        <div class="capability-grid">
          {capabilities.map(([number, title, description]) => (
            <article class="capability-card">
              <span class="number">{number}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="work">
      <div class="container">
        <div class="section-heading">
          <div><p class="eyebrow">Selected work</p><h2>Systems, execution, and proof—not a list of tasks.</h2></div>
          <p>Case studies describe documented contributions and outputs without inventing performance metrics or overstating technical ownership.</p>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <a class="project-card" href={`/work/${project.slug}/`}>
              <span class="project-index">{project.index}</span>
              <div>
                <small>{project.category}</small>
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
              </div>
              <div class:list={['project-visual', !project.image && 'project-visual--abstract']}>
                {project.image && <img src={project.image} alt={project.imageAlt || ''} loading="lazy" />}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="proof">
      <div class="container">
        <div class="section-heading">
          <div><p class="eyebrow">Proof of work</p><h2>Real artifacts, condensed for fast review.</h2></div>
          <p>Public previews use verified project screenshots and avoid applicant-level personal data, sensitive internal identifiers, and unsupported claims.</p>
        </div>
        <div class="proof-grid">
          <figure class="proof-card">
            <img src="/assets/avodah-ops.webp" alt="Composite of Avodah operations dashboards and workflow systems" loading="lazy" />
            <figcaption><strong>Operations systems</strong><span>Workflow architecture, dashboards, recruitment, activity monitoring, and calendar coordination.</span></figcaption>
          </figure>
          <figure class="proof-card">
            <img src="/assets/avodah-creative.webp" alt="Composite of Avodah campaign and financial education graphics" loading="lazy" />
            <figcaption><strong>Campaign execution</strong><span>Audience-specific financial education, protection, consultation, and brand assets.</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section" id="experience">
      <div class="container">
        <div class="section-heading">
          <div><p class="eyebrow">Professional experience</p><h2>Built through administration, service, coordination, and leadership.</h2></div>
          <p>The portfolio focuses on current capabilities, while this timeline shows the experience that developed the communication, documentation, and operational discipline behind them.</p>
        </div>
        <div class="experience-list">
          {experience.map(([date, company, role, description]) => (
            <article class="experience-row">
              <time>{date}</time>
              <div><strong>{company}</strong><span>{role}</span></div>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="container">
        <div class="contact-panel glass-panel">
          <p class="eyebrow">Work with JC</p>
          <h2>Need stronger structure behind the work?</h2>
          <p>Share the operational challenge, what tools are already in place, and what a better outcome should look like. I’m open to ongoing support, workflow projects, documentation work, and focused digital operations engagements.</p>
          <div class="contact-links">
            <a class="button" href={`mailto:${site.email}`}>Email JC</a>
            <a class="button button--ghost" href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
            <a class="button button--ghost" href={site.social.whatsapp} target="_blank" rel="noopener">WhatsApp ↗</a>
            <a class="button button--ghost" href={site.social.freelancer} target="_blank" rel="noopener">Freelancer ↗</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
