---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';
import { websiteStructuredData } from '../lib/structured-data';
import { coreTools, site } from '../site.config';

const capabilities = [
  ['01 · Core', 'Business Operations', 'Administrative coordination, operational support, reporting, task management, workflow organization, and day-to-day execution.'],
  ['02', 'Executive Support', 'Calendar management, appointment coordination, executive communication, documentation, and leadership support.'],
  ['03', 'Workflow Automation', 'Google Sheets, Apps Script, automated dashboards, trackers, and practical process optimization.'],
  ['04', 'Business Documentation', 'SOPs, policies, proposals, service agreements, process documentation, and internal knowledge systems.'],
  ['05', 'Digital Operations', 'Website management, content updates, QA, GitHub workflows, deployments, and digital systems support.'],
  ['06', 'Marketing Support', 'Content planning, social media coordination, campaign support, graphic design, and marketing operations.']
];

const experience = [
  ['2026 — Present', 'Avodah Wealth Advisory', 'Administrative Assistant / General Admin Support', 'Business operations, executive coordination, recruitment, CRM/client workflows, dashboards, documentation, website operations, and digital marketing support.'],
  ['2025', 'KRISS.AI', 'Outreach Specialist & Co-Team Leader · Part-time', 'Outreach coordination, prospect communication, lead follow-up, and AI-solution positioning for healthcare organizations.'],
  ['2023', 'Teleperformance', 'Customer Service Representative', 'High-volume customer support, CRM records, follow-ups, issue resolution, and service-quality execution.'],
  ['2022', 'Concentrix', 'Customer Service Representative', 'Outbound customer communication, renewals, account updates, objection handling, and internal coordination.'],
  ['2022', 'Philippine Army Reserve Command', 'Documentation & Communication Officer', 'Official documentation, reports, records, scheduling, and structured internal communication.'],
  ['2018 — 2021', 'Barangay Tagabaca', 'Sangguniang Kabataan Chairman', 'Leadership, community-project coordination, budgeting, documentation, events, and stakeholder communication.']
];
---
<BaseLayout structuredData={websiteStructuredData}>
  <Header />
  <main id="main">
    <section class="hero hero--home">
      <div class="container hero-grid hero-grid--home">
        <div class="hero-copy">
          <p class="eyebrow" data-motion="hero" style="--motion-delay: 0ms">Business Operations · Executive Support · Digital Systems</p>
          <p class="hero-name" data-motion="hero" style="--motion-delay: 70ms"><strong>Joshua Carl Pelotea</strong><span>Known professionally as JC</span></p>
          <h1 class="home-title" data-motion="hero" style="--motion-delay: 150ms">Bringing structure to <span class="soft">people, processes,</span> and daily execution.</h1>
          <p class="lede" data-motion="hero" style="--motion-delay: 235ms">I help executives, entrepreneurs, and growing businesses stay organized, efficient, and focused on growth through reliable administrative, operational, and digital support.</p>
          <div class="hero-actions" data-motion="hero" style="--motion-delay: 325ms">
            <a class="button" href="/work/">See systems &amp; proof <span aria-hidden="true">→</span></a>
            <a class="button button--ghost hero-booking-cta" href={site.booking} target="_blank" rel="noopener">Book a call ↗</a>
          </div>
          <div class="hero-meta" data-motion="hero" style="--motion-delay: 400ms" aria-label="Core disciplines">
            <span class="tag">Business Operations</span>
            <span class="tag">Executive Support</span>
            <span class="tag">Workflow Automation</span>
            <span class="tag">Digital Operations</span>
          </div>
        </div>
        <aside class="identity-card identity-card--home glass-panel" data-motion="hero-card" style="--motion-delay: 180ms">
          <div class="identity-card__meta"><span>JC / Operations profile</span><span>Philippines</span></div>
          <small>The operations mindset</small>
          <blockquote>Support both people and processes.</blockquote>
          <p>Clear priorities. Practical systems. Proactive communication. Reliable follow-through.</p>
          <div class="identity-focus">
            <div><span>Core focus</span><strong>Business Operations</strong></div>
            <div><span>Support layer</span><strong>Executive + Administrative</strong></div>
            <div><span>Systems layer</span><strong>Automation + Documentation</strong></div>
            <div><span>Digital layer</span><strong>Web + Campaign Operations</strong></div>
          </div>
        </aside>
      </div>
    </section>

    <section class="tool-strip" aria-labelledby="tools-heading">
      <div class="container tool-strip__inner">
        <div data-motion="rise">
          <p class="eyebrow" id="tools-heading">Core tools</p>
          <p>Platforms used across documented operations, automation, digital, and campaign work.</p>
        </div>
        <div class="tool-badges" aria-label="Core software stack">
          {coreTools.map((tool, index) => <span data-motion="rise" style={`--motion-delay: ${index * 48}ms`}>{tool}</span>)}
        </div>
      </div>
    </section>

    <section class="section" id="capabilities">
      <div class="container">
        <div class="section-heading" data-motion="rise">
          <div><p class="eyebrow">Capabilities</p><h2>Operations-led support with a practical digital layer.</h2></div>
          <p>Business Operations is the anchor. The supporting capabilities extend the same focus on clarity, visibility, accountability, and consistent execution.</p>
        </div>
        <div class="capability-grid">
          {capabilities.map(([number, title, description], index) => (
            <article class="capability-card" data-motion="rise" style={`--motion-delay: ${index * 65}ms`}>
              <span class="number">{number}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="work">
      <div class="container">
        <div class="section-heading" data-motion="rise">
          <div><p class="eyebrow">Selected work</p><h2>Systems, execution, and proof—not a list of tasks.</h2></div>
          <p>Case studies focus on documented contributions, deliverables, operating outcomes, and the systems used to support the work.</p>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card" data-motion="project">
              <span class="project-index">{project.index}</span>
              <a class="project-card__copy" href={`/work/${project.slug}/`}>
                <small>{project.category}</small>
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
                <span class="project-card__cta">View case study →</span>
              </a>
              {project.image ? (
                <button
                  class="project-visual project-visual--button"
                  type="button"
                  data-lightbox-src={project.image}
                  data-lightbox-alt={project.imageAlt || ''}
                  data-lightbox-caption={`${project.title} — portfolio evidence preview`}
                  aria-label={`View larger ${project.title} preview`}
                >
                  <img
                    src={project.image}
                    alt={project.imageAlt || ''}
                    width={project.imageWidth}
                    height={project.imageHeight}
                    loading="lazy"
                  />
                  <span class="zoom-badge" aria-hidden="true">View larger ⤢</span>
                </button>
              ) : project.slug === 'ice-zeta' ? (
                <div class="project-visual project-visual--mockup project-visual--ice-zeta" aria-hidden="true">
                  <span class="mockup-kicker">Brand system</span>
                  <strong>ICE Zeta Group</strong>
                  <div class="mockup-chip-row"><span>Brand guidelines</span><span>Website</span><span>Content system</span></div>
                </div>
              ) : (
                <div class="project-visual project-visual--mockup project-visual--konnevia" aria-hidden="true">
                  <span class="mockup-kicker">Product operations</span>
                  <strong>Konnevia</strong>
                  <div class="mockup-chip-row"><span>Profile</span><span>AI</span><span>Leads</span><span>Booking</span></div>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="proof">
      <div class="container">
        <div class="section-heading" data-motion="rise">
          <div><p class="eyebrow">Proof of work</p><h2>Real artifacts, condensed for fast review.</h2></div>
          <p>Public previews focus on publishable project artifacts and selected evidence. Select an image to inspect it at a larger size.</p>
        </div>
        <div class="proof-grid">
          <figure class="proof-card" data-motion="scale">
            <button
              class="proof-media"
              type="button"
              data-lightbox-src="/assets/avodah-ops-proof.webp"
              data-lightbox-alt="Composite of selected Avodah operations dashboards and workflow system screenshots"
              data-lightbox-caption="Avodah operations systems — dashboards, workflow architecture, recruitment, activity monitoring, and calendar coordination"
              aria-label="View larger Avodah operations systems preview"
            >
              <img
                src="/assets/avodah-ops-proof.webp"
                alt="Composite of selected Avodah operations dashboards and workflow system screenshots"
                width="1120"
                height="630"
                loading="lazy"
              />
              <span class="zoom-badge" aria-hidden="true">View larger ⤢</span>
            </button>
            <figcaption><strong>Operations systems</strong><span>Workflow architecture, dashboards, recruitment, activity monitoring, and calendar coordination.</span></figcaption>
          </figure>
          <figure class="proof-card" data-motion="scale" style="--motion-delay: 70ms">
            <button
              class="proof-media"
              type="button"
              data-lightbox-src="/assets/avodah-creative-proof.webp"
              data-lightbox-alt="Composite of selected Avodah campaign graphics and content-plan screenshot"
              data-lightbox-caption="Avodah campaign execution — audience-specific financial education, protection, consultation, and brand assets"
              aria-label="View larger Avodah campaign execution preview"
            >
              <img
                src="/assets/avodah-creative-proof.webp"
                alt="Composite of selected Avodah campaign graphics and content-plan screenshot"
                width="1120"
                height="630"
                loading="lazy"
              />
              <span class="zoom-badge" aria-hidden="true">View larger ⤢</span>
            </button>
            <figcaption><strong>Campaign execution</strong><span>Audience-specific financial education, protection, consultation, and brand assets.</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section" id="experience">
      <div class="container">
        <div class="section-heading" data-motion="rise">
          <div><p class="eyebrow">Professional experience</p><h2>Built through administration, service, coordination, and leadership.</h2></div>
          <p>The portfolio focuses on current capabilities, while this timeline shows the experience that developed the communication, documentation, and operational discipline behind them.</p>
        </div>
        <div class="experience-list" data-motion-timeline>
          {experience.map(([date, company, role, description], index) => (
            <article class="experience-row" data-motion="rise" style={`--motion-delay: ${index * 45}ms`}>
              <time>{date}</time>
              <div><strong>{company}</strong><span>{role}</span></div>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="container">
        <div class="contact-panel glass-panel">
          <p class="eyebrow" data-motion="rise">Work with JC</p>
          <h2 data-motion="rise" style="--motion-delay: 70ms">Need stronger structure behind the work?</h2>
          <p data-motion="rise" style="--motion-delay: 145ms">Share the operational challenge, what tools are already in place, and what a better outcome should look like. Book a 30-minute discovery call to discuss priorities, or email me if you would rather start asynchronously.</p>
          <p class="availability-note availability-note--contact" data-motion="rise" style="--motion-delay: 190ms"><span aria-hidden="true"></span>{site.availability}</p>
          <div class="contact-links" data-motion="rise" style="--motion-delay: 225ms">
            <a class="button" href={site.booking} target="_blank" rel="noopener">Book a discovery call ↗</a>
            <a class="button button--ghost" href={`mailto:${site.email}`}>Email JC</a>
            <a class="button button--ghost" href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
            <a class="button button--ghost" href={site.social.freelancer} target="_blank" rel="noopener">Freelancer ↗</a>
            <a class="button button--ghost" href={site.social.github} target="_blank" rel="noopener">GitHub ↗</a>
          </div>
          <p class="contact-secondary">Direct messaging: <a href={site.social.whatsapp} target="_blank" rel="noopener">WhatsApp</a> · <a href={site.social.messenger} target="_blank" rel="noopener">Messenger</a> · <a href={site.social.viber} title="Requires the Viber app">Viber app</a> <span aria-label={`Viber number ${site.social.viberNumber}`}>({site.social.viberNumber})</span>. Social profile: <a href={site.social.facebook} target="_blank" rel="noopener">Facebook</a>.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
