---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profilePageStructuredData } from '../lib/structured-data';
import { site } from '../site.config';
---
<BaseLayout
  title="About Joshua Carl Pelotea (JC) | Business Operations & Executive Support"
  description="Professional profile of Joshua Carl Pelotea (JC), a Business Operations & Executive Support Specialist based in the Philippines."
  canonical="/about/"
  structuredData={profilePageStructuredData}
>
  <Header />
  <main id="main">
    <section class="page-hero">
      <div class="container">
        <div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>About</span></div>
        <p class="eyebrow">Professional profile</p>
        <h1>Joshua Carl Pelotea <span class="soft">— JC.</span></h1>
        <p class="lede">Administrative and Business Operations professional working across executive support, workflow systems, documentation, digital operations, customer support, and marketing execution.</p>
      </div>
    </section>

    <section class="section--compact">
      <div class="container about-grid">
        <aside class="profile-panel glass-panel">
          <div class="profile-identity">
            <img
              class="profile-portrait"
              src="/assets/jc-pelotea-portrait.jpg"
              alt="Professional portrait of Joshua Carl Pelotea (JC)"
              width="576"
              height="720"
              loading="lazy"
              decoding="async"
            />
            <div class="profile-copy">
              <h3>{site.role}</h3>
              <p>{site.location}</p>
            </div>
          </div>
          <p class="availability-note"><span aria-hidden="true"></span>{site.availability}</p>
          <div class="contact-links">
            <a class="button button--small" href={site.booking} target="_blank" rel="noopener">Book a call ↗</a>
            <a class="button button--ghost button--small" href={`mailto:${site.email}`}>Email</a>
            <a class="button button--ghost button--small" href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          </div>
        </aside>
        <div>
          <p class="eyebrow">How I work</p>
          <h2>Practical support for both people and processes.</h2>
          <p class="lede">I bring strong attention to detail, clear communication, practical problem-solving, and adaptability across changing priorities, tools, and systems.</p>
          <p>My current work combines administrative assistance with business operations: coordinating recurring work, building dashboards and trackers, documenting processes, supporting leadership, maintaining digital systems, and helping projects move from idea to usable output.</p>
          <p>I use productivity tools, automation, and AI-assisted solutions where they add practical value—especially for organizing information, reducing repetitive work, improving documentation, troubleshooting workflows, and supporting digital execution. They support judgment rather than replace it.</p>

          <section class="section--compact">
            <p class="eyebrow">Core competency groups</p>
            <div class="credential-grid">
              <article class="credential"><h3>Operations & Support</h3><span>Administrative assistance, business operations, executive support, project coordination, calendars, records, stakeholder communication.</span></article>
              <article class="credential"><h3>Systems & Automation</h3><span>Google Sheets, Apps Script, workflow automation, reporting, dashboards, process improvement, AI-assisted productivity.</span></article>
              <article class="credential"><h3>Digital Operations</h3><span>GitHub, Netlify, website management, content management, digital QA, deployment coordination.</span></article>
              <article class="credential"><h3>Marketing & Design</h3><span>Digital marketing, social media management, content strategy, campaign coordination, and Canva.</span></article>
            </div>
          </section>

          <section class="section--compact">
            <p class="eyebrow">Credentials</p>
            <div class="credential-grid">
              <article class="credential"><h3>EF SET English Certificate</h3><span>C1 Advanced · Score 65/100 · October 2025</span></article>
              <article class="credential"><h3>Graphic Design · Alison</h3><span>Assessment score 90% · February 2024</span></article>
            </div>
          </section>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
