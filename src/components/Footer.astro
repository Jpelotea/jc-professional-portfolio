---
import { site } from '../site.config';
import FooterIcon from './FooterIcon.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-identity">
      <strong>{site.shortName}</strong>
      <p>{site.compactRole}</p>
    </div>
    <div class="footer-links" aria-label="Professional contact links">
      <a href={site.booking} target="_blank" rel="noopener"><FooterIcon name="calendar" /><span>Book a call</span></a>
      <a href={`mailto:${site.email}`}><FooterIcon name="email" /><span>Email</span></a>
      <a href={site.social.linkedin} target="_blank" rel="noopener"><FooterIcon name="linkedin" /><span>LinkedIn</span></a>
      <a href={site.social.github} target="_blank" rel="noopener"><FooterIcon name="github" /><span>GitHub</span></a>
      <a href={site.social.freelancer} target="_blank" rel="noopener"><FooterIcon name="freelancer" /><span>Freelancer</span></a>
    </div>
    <p class="footer-note">© {year} {site.name}. Built for clarity, structure, and follow-through.</p>
  </div>
</footer>
