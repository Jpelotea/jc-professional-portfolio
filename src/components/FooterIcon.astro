---
interface Props {
  name: 'calendar' | 'email' | 'linkedin' | 'github' | 'freelancer';
}

const { name } = Astro.props;
---
<svg class={`footer-icon footer-icon--${name}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'calendar' && (
    <>
      <rect x="3.5" y="5.5" width="17" height="15" rx="3" />
      <path d="M7.5 3.5v4M16.5 3.5v4M3.5 9.5h17" />
      <path d="m9.5 15 1.7 1.7 3.6-4" />
    </>
  )}
  {name === 'email' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="3" />
      <path d="m4.5 7 7.5 6 7.5-6" />
    </>
  )}
  {name === 'linkedin' && (
    <path class="footer-icon__fill" d="M6.5 8.2H3.4V20h3.1V8.2ZM5 3.5A1.8 1.8 0 1 0 5 7a1.8 1.8 0 0 0 0-3.5ZM20.5 13.2c0-3.5-1.9-5.2-4.4-5.2-2 0-3 1.1-3.5 1.9V8.2H9.5V20h3.1v-5.9c0-1.6.3-3.1 2.3-3.1 1.9 0 2 1.8 2 3.2V20h3.1l.5-6.8Z" />
  )}
  {name === 'github' && (
    <path class="footer-icon__fill" fill-rule="evenodd" clip-rule="evenodd" d="M12 2.7a9.5 9.5 0 0 0-3 18.5c.5.1.7-.2.7-.5v-1.9c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 2.9.9.1-.7.4-1.1.7-1.4-2.3-.3-4.7-1.1-4.7-5.1 0-1.1.4-2.1 1.1-2.8-.1-.3-.5-1.3.1-2.8 0 0 .9-.3 2.9 1.1a10 10 0 0 1 5.2 0c2-1.4 2.9-1.1 2.9-1.1.6 1.5.2 2.5.1 2.8.7.7 1.1 1.7 1.1 2.8 0 4-2.4 4.8-4.7 5.1.4.3.7 1 .7 1.9v2.7c0 .3.2.6.7.5A9.5 9.5 0 0 0 12 2.7Z" />
  )}
  {name === 'freelancer' && (
    <path class="footer-icon__fill" d="M14.096 3.076l1.634 2.292L24 3.076M5.503 20.924l4.474-4.374-2.692-2.89m6.133-10.584L11.027 5.23l4.022.15M4.124 3.077l.857 1.76 4.734.294m-3.058 7.072l3.497-6.522L0 5.13m7.064 7.485l3.303 3.548 3.643-3.57 1.13-6.652-4.439-.228Z" />
  )}
</svg>
