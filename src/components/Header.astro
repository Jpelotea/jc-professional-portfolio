---
import { navigation, site } from '../site.config';
---
<header class="site-header">
  <div class="container nav-shell glass-panel">
    <a class="brand" href="/" aria-label={`${site.shortName} home`}>
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="brand-copy"><strong>{site.shortName}</strong><small>{site.role}</small></span>
    </a>
    <nav aria-label="Primary navigation">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="nav-actions">
      <button class="icon-button" type="button" data-theme-toggle aria-label="Switch color theme">◐</button>
      <a class="button button--small" href={`mailto:${site.email}`}>Work with JC</a>
    </div>
  </div>
</header>
