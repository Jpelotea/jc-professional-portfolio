{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/events"
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "CTA_EVENTS",
      "dataset": "jc_portfolio_cta_events"
    }
  ]
}
